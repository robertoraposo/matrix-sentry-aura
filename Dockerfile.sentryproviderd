FROM golang:1.24-bookworm AS build

WORKDIR /src

COPY go.mod ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux \
    go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/sentryproviderd \
    ./cmd/sentryproviderd

FROM node:22-bookworm-slim

ARG CODEX_VERSION=0.145.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && npm install -g "@openai/codex@${CODEX_VERSION}" \
    && npm cache clean --force \
    && groupadd --gid 65532 nonroot \
    && useradd --uid 65532 --gid 65532 --home-dir /home/nonroot --create-home --shell /usr/sbin/nologin nonroot \
    && mkdir -p /data/providers \
    && chown -R 65532:65532 /data/providers /home/nonroot \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/sentryproviderd /usr/local/bin/sentryproviderd

ENV HOME=/home/nonroot
ENV SENTRY_PROVIDERD_ROOT=/data/providers
ENV SENTRY_CODEX_BIN=/usr/local/bin/codex

USER 65532:65532

EXPOSE 8811
VOLUME ["/data/providers"]

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:8811/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]

ENTRYPOINT ["/usr/local/bin/sentryproviderd"]
CMD ["-http", "0.0.0.0:8811", "-root", "/data/providers"]
